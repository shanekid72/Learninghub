# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional compatibility fallback for legacy upstream consumers only
# Primary app module/completion flow now uses Supabase directly.
# If you still need the compatibility endpoint, set:
# LH_BASE_URL=https://<your-domain>/api/lh/upstream
LH_BASE_URL=
LH_API_KEY=

# Email delivery (Gmail SMTP primary, Resend optional fallback)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Learning Hub <contactus@sg.lulumoney.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
RESEND_API_KEY=

# App URLs / cron
APP_BASE_URL=
CRON_SECRET=

# YouTube unlisted sync
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_SYNC_LOOKBACK_HOURS=168

# OpenAI quiz draft generation
OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5-mini

# HR interview integrity
HR_INTEGRITY_ENABLED=false
HR_SCANNER_PROTOCOL=learninghub-hr
HR_INVITE_TTL_HOURS=72
HR_UPLOAD_TOKEN_TTL_MINUTES=180
HR_UPLOAD_TOKEN_SECRET=

# Auth
AUTH_ALLOWED_EMAIL_DOMAINS=
